TEST_PATH = /opt/linux_dd_test/
TEST_NAME = $(shell basename $(CURDIR))

ifeq (,$(DESTDIR))
    DESTDIR = $(shell dirname $(shell dirname $(PWD)))/image
endif

.PHONY: install

install:
	install -d $(DESTDIR)$(TEST_PATH)$(TEST_NAME)
	cp -f cpu_hotplug_test.sh $(DESTDIR)$(TEST_PATH)$(TEST_NAME)
